class_name RegionData
extends Resource

## Group of zones sharing a look (map background, enclosure style). Generated by `tools/gen_zoo_content.py`.

@export var region_id: String = "home"
@export var display_name: String = "Родные края"
@export var icon: String = "🏡"
## Map background gradient for this stretch of the road.
@export var color_top: Color = Color("FFE3CC")
@export var color_bottom: Color = Color("D9EFC0")
## Shown on the hop to the NEXT region (boat, plane...).
## Zone screen background above the horizon (sea: water, lost world: volcanic haze).
@export var sky_color: Color = Color("CDEBF7")
@export var transition_icon: String = ""
## How enclosures are drawn in this region: fence | ice | dome | palisade.
@export_enum("fence", "ice", "dome", "palisade") var enclosure_style: String = "fence"
@export var zones: Array[ZoneData] = []
