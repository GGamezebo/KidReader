class_name LevelsCatalog
extends Resource

## Zoo campaign: regions → zones → levels. Keep level_id / zone_id stable — they are progress keys.
## level_id = zone_number * 100 + index (101, 102, ... 2101). Generated by `tools/gen_zoo_content.py`.

@export var regions: Array[RegionData] = []

var _levels: Array[LevelData] = []
var _zones: Array[ZoneData] = []


## All levels in campaign order.
func get_levels() -> Array[LevelData]:
	_ensure_cache()
	return _levels


## All zones in campaign order.
func get_zones() -> Array[ZoneData]:
	_ensure_cache()
	return _zones


func get_by_id(level_id: int) -> LevelData:
	for level in get_levels():
		if level.level_id == level_id:
			return level
	return null


func get_zone(zone_id: String) -> ZoneData:
	for zone in get_zones():
		if zone.zone_id == zone_id:
			return zone
	return null


func get_zone_of_level(level_id: int) -> ZoneData:
	for zone in get_zones():
		if zone.has_level(level_id):
			return zone
	return null


func get_region_of_zone(zone_id: String) -> RegionData:
	for region in regions:
		if region == null:
			continue
		for zone in region.zones:
			if zone and zone.zone_id == zone_id:
				return region
	return null


func zone_index(zone_id: String) -> int:
	var zones := get_zones()
	for i in zones.size():
		if zones[i].zone_id == zone_id:
			return i
	return -1


## Next zone in campaign order, or null after the last one.
func next_zone(zone_id: String) -> ZoneData:
	var idx := zone_index(zone_id)
	var zones := get_zones()
	if idx < 0 or idx + 1 >= zones.size():
		return null
	return zones[idx + 1]


## Next level inside the same zone, or -1 when this was the zone's last level.
func next_in_zone(level_id: int) -> int:
	var zone := get_zone_of_level(level_id)
	if zone == null:
		return -1
	var idx := zone.index_of(level_id)
	if idx < 0 or idx + 1 >= zone.levels.size():
		return -1
	return zone.levels[idx + 1].level_id


func count() -> int:
	return get_levels().size()


func _ensure_cache() -> void:
	if not _zones.is_empty():
		return
	for region in regions:
		if region == null:
			continue
		for zone in region.zones:
			if zone == null:
				continue
			_zones.append(zone)
			for level in zone.levels:
				if level:
					_levels.append(level)
