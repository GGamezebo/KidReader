class_name ZoneData
extends Resource

## One zoo zone = a pack of levels. Filled zone → festival (reading exam) → next zone unlocks.
## Generated by `tools/gen_zoo_content.py`.

## Stable id — progress key for festivals. Never rename.
@export var zone_id: String = "farm"
@export var display_name: String = "Домашний двор"
## Placeholder glyph until real icons exist.
@export var icon: String = "🐄"
@export var color: Color = Color("F3C969")
## Animal cards shown per festival round.
@export_range(2, 8) var festival_cards: int = 3
## Ordered short → long word.
@export var levels: Array[LevelData] = []


func has_level(level_id: int) -> bool:
	return index_of(level_id) >= 0


func index_of(level_id: int) -> int:
	for i in levels.size():
		if levels[i] and levels[i].level_id == level_id:
			return i
	return -1
