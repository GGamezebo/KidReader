class_name VoiceBank
extends Resource

## Recorded voice clips: letter SOUNDS (phonics, not names) and whole words.
## Generated by `tools/generate_voice.py` — rerun it after adding a level.

@export var letters: Dictionary[String, AudioStream] = {}
@export var words: Dictionary[String, AudioStream] = {}


func get_letter(part: String) -> AudioStream:
	return letters.get(part.to_upper()) as AudioStream


func get_word(word: String) -> AudioStream:
	return words.get(word.to_upper()) as AudioStream
